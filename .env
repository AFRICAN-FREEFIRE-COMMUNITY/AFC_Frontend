NEXT_PUBLIC_BACKEND_API_URL=https://api.africanfreefirecommunity.com
NEXT_PUBLIC_URL=https://africanfreefirecommunity.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=679225533678-1mt0llcro4cr6q0aa6aa3cp1rc8r1k41.apps.googleusercontent.com

NEXT_PUBLIC_DISCORD_SSO_ENABLED=true

# "Continue with v-ent.co" on the login and register pages (owner 2026-08-28).
#
# ON as of 2026-08-28, once v-ent.co registered AFC's SIGN-IN callback. It briefly shipped as
# false, because Provider.enabled() on the backend only checks that VENT_CLIENT_ID and
# VENT_CLIENT_SECRET exist: with the flag on but the redirect unregistered, players would have seen
# the button and been refused at the consent screen with BAD_REDIRECT, which is worse than no
# button.
#
# Verified before flipping, not assumed:
#   authorize-info with the sign-in redirect answers "AFRICAN FREE FIRE COMMUNITY" (it answered
#   BAD_REDIRECT earlier the same day), and following the URL AFC's own /auth/vent/sso/start/
#   builds lands on v-ent.co's consent page with HTTP 200.
#
# If it ever needs turning off again, this is the switch, and re-check with:
#   curl -s -G "https://api.v-ent.co/partners/sso/authorize-info/" #     --data-urlencode "client_id=<VENT_CLIENT_ID>" #     --data-urlencode "redirect_uri=https://api.africanfreefirecommunity.com/auth/vent/sso/callback/" #     --data-urlencode "scope=identity"
#
# NOTE THIS IS A BUILD-TIME VALUE. next build inlines every NEXT_PUBLIC_* into the bundle, which is
# why this file is committed and kept OUT of .dockerignore. Setting it on the running container
# does nothing.
NEXT_PUBLIC_VENT_SSO_ENABLED=true
